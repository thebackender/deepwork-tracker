# Copy this file to .env and adjust. .env is ignored by git.

# Folder for monthly backups of deepwork_logs.md (default: ~/deepwork-backup)
DW_BACKUP_DIR=~/deepwork-backup

# Folder for the Excel (.xlsx) copies of the backups (default: same as DW_BACKUP_DIR)
DW_XLSX_BACKUP_DIR=~/deepwork-backup-xlsx
